    "group": { "default": "Advanced" },
    "title": { "default": "Compass Footer" },
    "description": { "default": "Compass site footer (Stay Connected / Quick Access links + stock ticker). Add as the last section on any page that should show it — it no longer appears automatically on every page." },
    "officeFabricIconFontName": "Page",
    "properties": {
      "companyName": "Compass",
      "stockApiUrl": "https://bpcstarbulkwebapi.azurewebsites.net/api/GetStockPrice"
