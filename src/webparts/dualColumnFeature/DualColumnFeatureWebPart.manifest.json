    "group": { "default": "Advanced" },
    "title": { "default": "Compass Dual Column Feature" },
    "description": { "default": "A full-width colored strip with two white cards, each with its own title and bulleted list." },
    "officeFabricIconFontName": "DoubleColumn",
    "properties": {
          "bgColor": "#082244",
          "leftTitle": "Title 1",
          "leftItems": [{ "text": "Introduction of each section." }],
          "rightTitle": "Title 2",
          "rightItems": [{ "text": "Introduction of each section." }]
    }
  }]
}
