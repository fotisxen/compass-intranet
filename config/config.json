{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "hello-world-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/helloWorld/HelloWorldWebPart.js",
          "manifest": "./src/webparts/helloWorld/HelloWorldWebPart.manifest.json"
        }
      ]
    },
    "news-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/news/NewsWebPart.js",
          "manifest": "./src/webparts/news/NewsWebPart.manifest.json"
        }
      ]
    },
    "news-card-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/newsCard/NewsCardWebPart.js",
          "manifest": "./src/webparts/newsCard/NewsCardWebPart.manifest.json"
        }
      ]
    },
    "chat-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/chat/ChatWebPart.js",
          "manifest": "./src/webparts/chat/ChatWebPart.manifest.json"
        }
      ]
    },
    "fleet-map-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/fleetMap/FleetMapWebPart.js",
          "manifest": "./src/webparts/fleetMap/FleetMapWebPart.manifest.json"
        }
      ]
    },
    "events-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/events/EventsWebPart.js",
          "manifest": "./src/webparts/events/EventsWebPart.manifest.json"
        }
      ]
    },
    "holidays-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/holidays/HolidaysWebPart.js",
          "manifest": "./src/webparts/holidays/HolidaysWebPart.manifest.json"
        }
      ]
    },
    "footer-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/footer/FooterWebPart.js",
          "manifest": "./src/webparts/footer/FooterWebPart.manifest.json"
        }
      ]
    },
    "compass-chrome-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/compassChrome/CompassChromeApplicationCustomizer.js",
          "manifest": "./src/extensions/compassChrome/CompassChromeApplicationCustomizer.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "HelloWorldWebPartStrings": "lib/webparts/helloWorld/loc/{locale}.js",
    "NewsWebPartStrings": "lib/webparts/news/loc/{locale}.js",
    "NewsCardWebPartStrings": "lib/webparts/newsCard/loc/{locale}.js",
    "ChatWebPartStrings": "lib/webparts/chat/loc/{locale}.js",
    "FleetMapWebPartStrings": "lib/webparts/fleetMap/loc/{locale}.js",
    "EventsWebPartStrings": "lib/webparts/events/loc/{locale}.js",
    "HolidaysWebPartStrings": "lib/webparts/holidays/loc/{locale}.js",
    "FooterWebPartStrings": "lib/webparts/footer/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}